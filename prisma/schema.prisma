generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  STOCK
  ETF
  FUND
  BOND
  CASH
  CRYPTO
  OTHER
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  DEPOSIT
  WITHDRAWAL
  FEE
  TAX
  INTEREST
  TRANSFER
  SPLIT
  OTHER
}

enum DividendStatus {
  ANNOUNCED
  CONFIRMED
  PAID
}

enum CorporateActionType {
  SPLIT
  REVERSE_SPLIT
  MERGER
  SPINOFF
  TICKER_CHANGE
}

enum CostBasisMethod {
  AVERAGE_COST
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  passwordHash   String?
  /// BCP 47 tag driving every number/date format in the UI (see
  /// lib/utils/format.ts) - a Belgian user wants "127.438,20 EUR" and
  /// "16 sep 2026", a US one "$127,438.20" and "Sep 16, 2026". Display
  /// only: it never affects stored values or any Decimal math.
  locale         String          @default("en-US")
  portfolios     Portfolio[]
  watchlistItems WatchlistItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Portfolio {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  baseCurrency      String
  /// Locked in once the portfolio has any transactions - see lib/finance/costBasis.ts
  accountingMethod  CostBasisMethod    @default(AVERAGE_COST)
  /// Ticker the Analytics page compares this portfolio against. Null falls
  /// back to DEFAULT_BENCHMARK_TICKER; it's nullable rather than defaulted
  /// so changing that default also moves every portfolio that never picked
  /// one of its own.
  benchmarkTicker   String?
  /// Withholding rate applied to projected dividends (see
  /// lib/finance/dividendCalendar.ts). Defaults to the Belgian 30% flat
  /// "roerende voorheffing"; configurable because the same app is useful
  /// to someone taxed elsewhere.
  dividendTaxRate   Decimal            @default(0.30) @db.Decimal(5, 4)
  isDefault         Boolean            @default(true)
  accounts          Account[]
  allocationTargets AllocationTarget[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
}

model AllocationTarget {
  id            String    @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  /// One of `AllocationDimension` in types/domain.ts (e.g. "assetType",
  /// "sector", "currency") — not a DB enum, since new dimensions shouldn't
  /// need a migration.
  dimension     String
  /// The bucket this target applies to within `dimension` — e.g. "STOCK"
  /// for assetType, "Technology" for sector, "EUR" for currency.
  key           String
  targetPercent Decimal   @db.Decimal(6, 4)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([portfolioId, dimension, key])
}

model Account {
  id                  String        @id @default(cuid())
  portfolioId         String
  portfolio           Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name                String
  brokerName          String?
  accountNumberMasked String?
  currency            String
  transactions        Transaction[]
  importBatches       ImportBatch[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([portfolioId])
}

model Security {
  id               String            @id @default(cuid())
  ticker           String
  name             String
  isin             String?
  assetType        AssetType
  /// Passed through as-is to the configured FinancialDataProvider (e.g.
  /// Twelve Data expects "Euronext", "NASDAQ" — not a MIC code or ISO name).
  exchange         String?
  currency         String
  country          String?
  sector           String?
  currentPrice     Decimal?          @db.Decimal(20, 8)
  priceUpdatedAt   DateTime?
  metadata         Json?
  transactions     Transaction[]
  prices           Price[]
  dividends        Dividend[]
  corporateActions CorporateAction[]
  watchlistItems   WatchlistItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([ticker, exchange])
  @@index([isin])
}

/// A security tracked without owning it — no transactions, just "keep an
/// eye on this price". Deliberately independent of Portfolio/Account: a
/// watchlist is a per-user thing, not a per-portfolio one.
model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityId  String
  security    Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  notes       String?
  /// A "buy the dip" alert threshold, in the security's own currency —
  /// the row highlights once the current price is at or below this.
  /// Purely visual (no email/push); null means no alert is set.
  targetPrice Decimal? @db.Decimal(20, 8)
  createdAt   DateTime @default(now())

  @@unique([userId, securityId])
  @@index([securityId])
}

model Transaction {
  id           String          @id @default(cuid())
  accountId    String
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  securityId   String?
  security     Security?       @relation(fields: [securityId], references: [id])
  type         TransactionType
  date         DateTime        @db.Date
  quantity     Decimal?        @db.Decimal(20, 8)
  price        Decimal?        @db.Decimal(20, 8)
  grossAmount  Decimal         @db.Decimal(18, 4)
  fees         Decimal         @default(0) @db.Decimal(18, 4)
  taxes        Decimal         @default(0) @db.Decimal(18, 4)
  netAmount    Decimal         @db.Decimal(18, 4)
  currency     String
  exchangeRate Decimal?        @db.Decimal(18, 8)
  notes        String?
  externalId   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([accountId, externalId])
  @@index([accountId, date])
  @@index([securityId])
}

model Price {
  id            String   @id @default(cuid())
  securityId    String
  security      Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  open          Decimal? @db.Decimal(20, 8)
  high          Decimal? @db.Decimal(20, 8)
  low           Decimal? @db.Decimal(20, 8)
  close         Decimal  @db.Decimal(20, 8)
  adjustedClose Decimal? @db.Decimal(20, 8)
  currency      String

  @@unique([securityId, date])
}

model Dividend {
  id               String         @id @default(cuid())
  securityId       String
  security         Security       @relation(fields: [securityId], references: [id], onDelete: Cascade)
  exDividendDate   DateTime       @db.Date
  recordDate       DateTime?      @db.Date
  paymentDate      DateTime?      @db.Date
  dividendPerShare Decimal        @db.Decimal(20, 8)
  currency         String
  source           String
  status           DividendStatus @default(CONFIRMED)

  @@index([securityId, exDividendDate])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  date          DateTime @db.Date
  rate          Decimal  @db.Decimal(18, 8)
  source        String

  @@unique([baseCurrency, quoteCurrency, date])
}

model CorporateAction {
  id            String              @id @default(cuid())
  securityId    String
  security      Security            @relation(fields: [securityId], references: [id], onDelete: Cascade)
  type          CorporateActionType
  effectiveDate DateTime            @db.Date
  /// Shape depends on `type`, e.g. SPLIT: { "ratio": "2:1" }
  details       Json
  createdAt     DateTime            @default(now())
}

model ImportBatch {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source    String
  fileName  String
  status    String
  /// { imported, skipped, duplicates, errors: [...] }
  summary   Json
  createdAt DateTime @default(now())

  @@index([accountId])
}
